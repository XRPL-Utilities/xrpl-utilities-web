// HYGIENE: this file is committed to a PUBLIC repo. Never inline
// account_id, kv_namespaces, secrets, or any account-bound IDs here.
// Sensitive bits go in .dev.vars (gitignored) or are set via the Cloudflare
// dashboard / `wrangler secret put`. If we ever wire real Workers state,
// keep this file structural (name, compatibility_date, flags) only.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xrpl-utilities-web",
  "compatibility_date": "2026-04-26",
  "main": "_worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // In static-assets mode the assets binding answers first and the Worker
    // only runs when nothing matches. That fallthrough is not reliable for
    // API paths: /api/x/pulse/stats and /api/x/vault/healthz were observed
    // returning the assets 404 (empty body) and the real upstream response
    // on alternating requests, depending on which handler won. Pinning
    // /api/* to the Worker removes the race for both the proxy and the
    // preview-token mint. /.well-known/x402 is built by the Worker too, and
    // the slashless page paths get a 301 from it instead of the assets 307.
    "run_worker_first": [
      "/api/*", "/.well-known/x402",
      "/start", "/sentinel", "/sentinel/bulk", "/telemetry", "/pulse", "/trust",
      "/vault", "/flows", "/lineage", "/pricing", "/status", "/contact", "/tip", "/terms", "/whales"
    ]
  },
  // Per-visitor limit on the /api/x passthrough, shared by the isolates in a
  // Cloudflare location (_worker.js also keeps its own in-memory count).
  // namespace_id is a number we pick, not an account ID; it only has to be
  // unique among this account's rate-limit bindings. period may be 10 or 60.
  "ratelimits": [
    {
      "name": "API_PROXY_LIMITER",
      "namespace_id": "4021",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
