#!/usr/bin/env bash
# Cloudflare deploys main on every push, before GitHub CI reports, so a red
# test in CI means the bad page is already live. Run the whole suite here and
# refuse the push when it fails. Bypass (rare, deliberate): git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if ! bash tests/run.sh >/tmp/xrpl-web-prepush.log 2>&1; then
  echo "pre-push: tests failed, push blocked (Cloudflare would deploy it)." >&2
  grep -E "FAIL|Error" /tmp/xrpl-web-prepush.log | head -20 >&2
  echo "full log: /tmp/xrpl-web-prepush.log" >&2
  exit 1
fi
echo "pre-push: all checks passed"
